generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  username    String       @unique
  email       String?      @unique
  games       GamePlayer[]
  submissions Submission[]

  @@map("players")
}

model Game {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  status       String
  storyPrompt  String
  currentStory String?
  players      GamePlayer[]
  rounds       Round[]

  @@map("games")
}

model GamePlayer {
  id       String @id @default(cuid())
  playerId String
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id])
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, gameId])
  @@map("game_players")
}

model Round {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  gameId      String
  roundNumber Int
  prompt      String
  game        Game         @relation(fields: [gameId], references: [id])
  submissions Submission[]

  @@map("rounds")
}

model Submission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  roundId   String
  playerId  String
  content   String
  player    Player   @relation(fields: [playerId], references: [id])
  round     Round    @relation(fields: [roundId], references: [id])
  votes     Vote[]

  @@unique([roundId, playerId])
  @@map("submissions")
}

model Vote {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  submissionId String
  voterId      String
  submission   Submission @relation(fields: [submissionId], references: [id])

  @@unique([submissionId, voterId])
  @@map("votes")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model AutoSave {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roomId      String
  playerId    String
  roundNumber Int
  content     String

  @@unique([roomId, playerId, roundNumber])
  @@map("auto_saves")
}
